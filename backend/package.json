{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=database/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=database/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=database/drizzle.config.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.11.0",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@ai-sdk/groq": "latest",
    "@ai-sdk/mistral": "latest",
    "@hono/node-server": "^2.0.3",
    "@hono/zod-validator": "^0.5.0",
    "ai": "^6.0.190",
    "argon2": "^0.43.0",
    "better-auth": "^1.6.11",
    "bullmq": "^5.56.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.21",
    "ioredis": "^5.10.1",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  }
}
