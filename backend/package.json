{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=database/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=database/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=database/drizzle.config.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@ai-sdk/groq": "latest",
    "@ai-sdk/mistral": "latest",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "ai": "^7.0.93",
    "argon2": "^0.45.1",
    "better-auth": "^1.7.3",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "zod": "^4.5.4"
  }
}
